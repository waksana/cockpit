{
  "name": "@waksana/cockpit-module-sdk",
  "version": "0.2.0",
  "type": "module",
  "license": "GPL-3.0-only",
  "description": "Public TypeScript SDK for trusted Cockpit modules",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/waksana/cockpit.git",
    "directory": "packages/module-api"
  },
  "files": ["dist", "runtime.js", "runtime.d.ts"],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./backend": {
      "types": "./dist/backend.d.ts",
      "import": "./dist/backend.js"
    },
    "./frontend": {
      "types": "./dist/frontend.d.ts",
      "import": "./dist/frontend.js"
    },
    "./runtime": {
      "types": "./runtime.d.ts",
      "import": "./runtime.js"
    }
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "peerDependencies": {
    "@types/node": ">=22 <26",
    "@types/react": ">=18 <20",
    "react": ">=18 <20"
  },
  "peerDependenciesMeta": {
    "@types/node": { "optional": true },
    "@types/react": { "optional": true },
    "react": { "optional": true }
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@types/react": "^19.2.18",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "node ../../scripts/generate-module-sdk.mjs --check && tsc -p tsconfig.build.json",
    "prepack": "pnpm build",
    "test": "node --test ../../scripts/module-sdk-pack.test.mjs"
  }
}
