{
  "name": "@cockpit/core",
  "version": "0.4.1",
  "type": "module",
  "files": [
    "src",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!src/**/__fixtures__/**",
    "!src/**/fixtures/**"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "regress": "node --import tsx test-support/regress.mts"
  },
  "dependencies": {
    "@cockpit/protocol": "workspace:*",
    "@github/copilot-sdk": "1.0.13"
  },
  "devDependencies": {
    "tsx": "^4.23.13"
  }
}
