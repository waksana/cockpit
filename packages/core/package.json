{
  "name": "@cockpit/core",
  "version": "0.5.0",
  "type": "module",
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "!dist/**/__tests__/**",
    "!dist/**/__fixtures__/**",
    "!dist/**/fixtures/**"
  ],
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "regress": "node --import tsx test-support/regress.mts",
    "typecheck:test": "tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@cockpit/protocol": "workspace:*",
    "@github/copilot-sdk": "1.0.13"
  },
  "devDependencies": {
    "tsx": "^4.23.13"
  }
}
