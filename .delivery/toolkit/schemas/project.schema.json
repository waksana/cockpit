{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "project.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "targetRef", "validation", "build", "delivery"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "projectId": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}$" },
    "targetRef": { "type": "string", "pattern": "^refs/heads/[^\\s]+$" },
    "validation": { "type": "array", "minItems": 1, "items": { "$ref": "#/definitions/argv" } },
    "build": {
      "type": "object", "additionalProperties": false,
      "required": ["argv", "artifactPaths"],
      "properties": {
        "argv": { "$ref": "#/definitions/argv" },
        "artifactPaths": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/definitions/path" } }
      }
    },
    "delivery": {
      "type": "object", "additionalProperties": false,
      "required": ["adapter", "environment", "busyPolicy", "healthPath", "versionPath"],
      "properties": {
        "adapter": { "enum": ["pending", "github-actions-v1"] },
        "environment": { "type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._-]{0,119}$" },
        "busyPolicy": { "const": "wait-no-force" },
        "healthPath": { "type": ["string", "null"], "pattern": "^/[^\\s]*$" },
        "versionPath": { "type": ["string", "null"], "pattern": "^/[^\\s]*$" }
      }
    }
  },
  "definitions": {
    "argv": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "path": { "type": "string", "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9_./-]+$" }
  }
}
