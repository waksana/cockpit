# ── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ── Build output (rebuilt via pnpm build; packaged runtimes run from dist) ───
dist/
dist-review/
*.tsbuildinfo

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Runtime secrets & state — NEVER COMMIT ───────────────────────────────────
# Local data and credentials are never source inputs.
apps/server/data/

# Local env / credential files (defense in depth — none are in-repo today, but
# guard so a future .env/key dropped here can never be committed).
.env
.env.*
!.env.example
secrets.env
*.pem
*.key
*.p12
*.pfx
*credentials*
*secret*.json

# ── Local databases ─────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# ── User-provided files (never package as source) ───────────────────────────
uploads/
cockpit-uploads/

# ── POC scratch ──────────────────────────────────────────────────────────────
poc/

# ── OS / editor noise ────────────────────────────────────────────────────────
.DS_Store
*.swp
.idea/
.vscode/
# ── Local runtime packaging output and isolated packaging fixtures ──────────
runtime-output/
.runtime-package-tests/
