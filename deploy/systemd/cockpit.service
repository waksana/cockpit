[Unit]
Description=Cockpit web interface for GitHub Copilot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=honglai
Group=honglai
WorkingDirectory=/home/honglai/cockpit-foundation/apps/server
Environment=HOME=/home/honglai
Environment=PATH=/home/honglai/.local/bin:/home/honglai/go/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=NODE_ENV=production
Environment=COCKPIT_PORT=8771
Environment=COCKPIT_HOME=/home/honglai/.copilot
Environment=COCKPIT_SERVE_WEB=1
Environment=COCKPIT_WEB_DIR=/home/honglai/cockpit-foundation/apps/web/dist
ExecStart=/home/honglai/.local/bin/node --import tsx src/index.ts
Restart=always
RestartSec=3
TimeoutStopSec=120
UMask=0077

[Install]
WantedBy=multi-user.target
