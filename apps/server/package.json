{
  "name": "@cockpit/server",
  "version": "0.2.0",
  "type": "module",
  "files": [
    "src",
    "!src/**/*.test.*",
    "!src/**/__tests__/**",
    "!src/**/__fixtures__/**",
    "!src/**/fixtures/**"
  ],
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node --import tsx src/index.ts",
    "build": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@cockpit/core": "workspace:*",
    "@cockpit/module-api": "workspace:*",
    "@cockpit/protocol": "workspace:*",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.12.3",
    "tsx": "^4.23.13",
    "zod": "^3.25.76",
    "zod-to-json-schema": "^3.25.2"
  }
}
